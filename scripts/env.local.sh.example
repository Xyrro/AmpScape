# Site settings for scripts/env.sh. Copy to scripts/env.local.sh (git-ignored) and fill in; never commit the copy.
export AMPSCAPE_ACCOUNT=""          # sbatch --account
export AMPSCAPE_QOS=""              # sbatch --qos
export AMPSCAPE_CPU_PARTITION=""    # generation, evaluation and maintenance jobs
export AMPSCAPE_GPU_PARTITION=""    # default GPU partition (training, transfer evaluation)
# GPU pools of scripts/slurm/gpu/gpu_driver.py in priority order: [[partition, qos, gres], ...]
export AMPSCAPE_GPU_POOLS='[]'
# concurrent two-hour GPU legs per QoS: {"<qos>": 16, ...}
export AMPSCAPE_GPU_QOS_LEGS='{}'
export AMPSCAPE_QUOTA_CMD="quota"   # prints a line "Scratch: <used GB> <quota GB> ..."
export AMPSCAPE_SCRATCH_FS=""       # mount point of the scratch file system (for `lfs quota`)
export AMPSCAPE_CLUSTER_PROFILE="local"   # configs/cluster/local.yaml (git-ignored copy of template.yaml)
# other conda envs the login shell activates: PATH entries to strip (ERE) and variables to unset
export AMPSCAPE_STRIP_PATH_RE="/anaconda3/"
export AMPSCAPE_UNSET_VARS=""
